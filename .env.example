# Configure these variables in the Netlify project before deploying.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CONTACT_EMAIL_TO=
# Required for Netlify builds; use the final public HTTPS origin without a trailing slash.
NEXT_PUBLIC_SITE_URL=

# Supabase público usado apenas pelo backoffice. Nunca adicionar a service role key ao browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
